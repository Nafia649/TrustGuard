# TrustGuard + REALKEY Backend Environment Configuration

# Database: SQLite for MVP development
DATABASE_URL=sqlite:///./trustguard.db

# Machine Learning Service Provider: mock (default for MVP) or real
ML_PROVIDER=mock

# WebAuthn / Security Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TrustGuard REALKEY
WEBAUTHN_ORIGIN=http://localhost:5173

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
